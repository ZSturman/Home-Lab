POSTGRES_DB=homeplatform
POSTGRES_USER=homeplatform
POSTGRES_HOST=postgres
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_BIND_IP=127.0.0.1
MQTT_BIND_PORT=1883
# Stable identity for the host that owns this Control Plane instance. Use a
# registered Node id such as macbook when moving the role to macOS.
HOMEPLATFORM_NODE_ID=pi-control-plane
HOMEPLATFORM_NODE_NAME=Home Pi
HOMEPLATFORM_NODE_HOSTNAME=kiosk-lab
# The default Compose stack is host-portable. Start USB services only with
# `--profile pi-hardware` on a Pi and set this value to pi-hardware there.
HOMEPLATFORM_HARDWARE_PROFILE=standard
HOME_ASSISTANT_URL=http://host.docker.internal:8123
WEBCAM_HOST_DEVICE=/dev/v4l/by-id/usb-046d_Brio_101_2602AP8RFCA8-video-index0
NEXT_PUBLIC_PLATFORM_NAME=Home Platform
# Not a secret: the Projects data source id, discoverable via NotionClient
# from either the database id or the data source id itself.
NOTION_PROJECTS_DATABASE_ID=304aec94-4d3c-80a8-82f6-fd7ff4d2b607
# The Node id that owns ~/Workspace/Projects and executes project.* commands.
HOMEPLATFORM_WORKSPACE_NODE_ID=macbook
# Workspace Sync & Backup Utility's dashboard (sibling project, same Pi) --
# its GET /api/storage/contract is the only source this project uses for
# disk/mount/storage-mode information. Leave blank to disable (storage
# status degrades to "unknown" rather than erroring). Put the matching
# WORKSPACE_DASHBOARD_TOKEN value in secrets/workspace_contract_token.
WORKSPACE_CONTRACT_URL=http://100.90.61.70:8787/api/storage/contract
