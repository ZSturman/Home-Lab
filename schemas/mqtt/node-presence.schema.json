{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "hostname"],
  "properties": {
    "status": {"enum": ["online", "offline", "degraded"]},
    "hostname": {"type": "string"},
    "os": {"type": "string"},
    "health": {"enum": ["healthy", "degraded", "offline", "unknown"]}
  },
  "additionalProperties": true
}
